<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TempApp">
        <activity
            android:name=".onboard.OnboardActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.TempApp"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".main.notification.NotificationActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.TempApp"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".main.message.MessageActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.TempApp"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".main.profile.MyWorkProfileActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.TempApp"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".main.profile.ProfileActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.TempApp"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".main.home.HomeActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.TempApp"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".auth.signin.PhoneSignInActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.TempApp"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".auth.signin.SignInActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.TempApp"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".auth.signup.SignUpActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.TempApp"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:theme="@style/Theme.TempApp"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>