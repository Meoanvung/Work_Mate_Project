# ===== Server =====
PORT=5000
NODE_ENV=development

# ===== MongoDB =====
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/work_mate_be
# Or MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/work_mate_be

# ===== JWT =====
# Change this to a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ===== OTP / Password reset =====
OTP_TTL_MINUTES=10
# Lifetime of the one-time token returned after reset OTP verification
PASSWORD_RESET_TOKEN_TTL_MINUTES=10

# ===== Email =====
# EMAIL_PROVIDER: auto | smtp | console
#   auto    = use SMTP if SMTP_USER is set, otherwise an auto-created Ethereal test inbox (dev only)
#   smtp    = always use the SMTP_* settings below
#   console = don't send real email; print the OTP to the server console (great for local dev / tests)
EMAIL_PROVIDER=console
EMAIL_FROM=WorkMate <no-reply@workmate.app>

# SMTP settings (used when EMAIL_PROVIDER=smtp or auto with values present)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
